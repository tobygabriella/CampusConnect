// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String  @id @default(uuid())
  name             String 
  email            String  @unique
  password         String?  // Null if using Google OAuth
  oauthProvider    String?  // 'google' or null for email signup
  oauthId          String?  @unique  // Stores Google user ID
  refreshToken     String?  // Stores refresh token for JWT refresh
  profilePicture   String?  // Profile image URL
  role             String?
  username         String?  @unique // Set after onboarding
  collegeId       String?
  college         College? @relation("StudentCollege", fields: [collegeId], references: [id])

  collegesServed  College[] @relation("CollegesServedByUser")
  isVerified       Boolean  @default(false) // For email verification
  verificationToken String? @unique // Stores email verification token
  createdAt        DateTime @default(now())
  serviceProvider  ServiceProvider?
  followers Follow[] @relation(name: "UserFollowers")
  following Follow[] @relation(name: "UserFollowing")
  appointmentsAsClient Appointment[] @relation("ClientAppointments")
  stripeCustomerId String?

  workPosts        WorkPost[] @relation("UserWorkPosts")
  forumPosts       ForumPost[]
  comments         Comment[]
  upvotes          Upvote[]
  downvotes        Downvote[]
  mentions         Mention[]
  notificationsReceived Notification[] @relation("Notification_user")
  notificationsSent     Notification[] @relation("NotificationSender")
}

model WorkPost {
  id             String   @id @default(uuid())
  caption        String   @db.Text
  images         String[]
  tags           String[] @default([])

  authorId       String
  author         User     @relation("UserWorkPosts", fields: [authorId], references: [id]) 

  serviceId      String?
  service        Service? @relation("ServiceWorkPosts", fields: [serviceId], references: [id])

  appointmentId  String?
  appointment    Appointment? @relation("AppointmentWorkPosts", fields: [appointmentId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  comments       Comment[]    @relation("WorkPostComments") 
  upvotes        Upvote[]     @relation("WorkPostUpvotes")  
  downvotes      Downvote[]   @relation("WorkPostDownvotes")
  notifications Notification[]
}

model Follow {
  id          String @id @default(uuid())
  followerId  String
  followingId String

  follower   User @relation(name: "UserFollowers", fields: [followerId], references: [id])
  following  User @relation(name: "UserFollowing", fields: [followingId], references: [id])

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId]) // Prevent duplicate follows
}

model College {
  id         String   @id @default(uuid())
  name       String
  state      String
  city       String
  originalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  serviceProviders User[]   @relation("CollegesServedByUser")
  students         User[]   @relation("StudentCollege") 
  forumPosts       ForumPost[]  @relation("CollegeForumPosts")
}

model Profession {
  id   String @id @default(uuid())
  name String @unique
  users ServiceProvider[] @relation("ServiceProviderProfession")
}

model ServiceProvider {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  stripeAccountId String? 
  professionId String?
  profession   Profession? @relation("ServiceProviderProfession", fields: [professionId], references: [id])
  policy        String?   @db.Text
  cancellationWindow Int        @default(48)
  rescheduleFee Float @default(0)
  biography     String?   @db.Text
  experience    String?   @db.Text
  location      String?
  workImages    String[]
  certifications String[]
  services      Service[]
  availability   Availability? @relation()
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  appointments Appointment[] @relation("ProviderAppointments")
}

model Availability {
  id                String  @id @default(uuid())
  serviceProviderId String  @unique
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id])
  availabilityData  Json // Stores available time slots as JSON
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}


model Service {
  id                String          @id @default(uuid())
  name              String
  price            Float
  depositAmount     Float?
  duration         Int              // Duration in minutes
  serviceProviderId String
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  bufferBefore  Int @default(0)
  bufferAfter   Int @default(0)
  appointments Appointment[] @relation("ServiceAppointments")
  workPosts WorkPost[] @relation("ServiceWorkPosts")
}

model Appointment {
  id                String   @id @default(uuid())
  clientId          String
  serviceId         String
  serviceProviderId String
  startTime         DateTime
  endTime           DateTime
  status            String   @default("confirmed")// e.g. confirmed, completed, cancelled, disputed, no_show_client, no_show_provider
  clientConfirmed   Boolean  @default(false)
  providerConfirmed Boolean  @default(false)
  clientConfirmedAt DateTime?
  providerConfirmedAt DateTime?
  autoCompleted     Boolean  @default(false)
  notes             String?  // optional field for leaving details after session
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reminder24hrSent        Boolean  @default(false)
  reminder1hrSent         Boolean  @default(false)
  confirmationPromptSent  Boolean  @default(false)
  
  client          User            @relation("ClientAppointments", fields: [clientId], references: [id])
  service         Service         @relation("ServiceAppointments", fields: [serviceId], references: [id])
  serviceProvider ServiceProvider @relation("ProviderAppointments", fields: [serviceProviderId], references: [id])

  stripePayments StripePayment[]
  workPosts WorkPost[] @relation("AppointmentWorkPosts")
  @@index([serviceProviderId, startTime, endTime])
  notifications Notification[]
}

model StripePayment {
  id              String   @id @default(uuid())
  paymentIntentId String   @unique
  appointmentId   String?
  type            String   // 'deposit' or 'remaining'
  status          String   // 'succeeded', 'failed', etc.
  amount          Int      // in cents
  currency        String   @default("usd")
  createdAt       DateTime @default(now())
  notifications Notification[]
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
}

model ForumPost {
  id          String      @id @default(uuid())
  title       String
  content     String      @db.Text
  authorId    String
  author      User        @relation(fields: [authorId], references: [id])
  collegeId String?
  college     College?    @relation("CollegeForumPosts", fields: [collegeId], references: [id])
  tags        String[]    @default([])
  upvotes     Upvote[]
  downvotes   Downvote[]
  comments    Comment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  notifications Notification[]
  @@index([collegeId]) // For filtering by college
}

model Comment {
  id          String      @id @default(uuid())
  content     String      @db.Text
  authorId    String
  author      User        @relation(fields: [authorId], references: [id])
  forumPostId String?  
  forumPost   ForumPost? @relation(fields: [forumPostId], references: [id])

  workPostId  String?
  workPost    WorkPost?  @relation("WorkPostComments", fields: [workPostId], references: [id])

  parentId    String?     // For nested comments
  parent      Comment?    @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[]   @relation("CommentReplies")
  upvotes     Upvote[]
  downvotes   Downvote[]
  mentions    Mention[]   // For @mentions
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  notifications Notification[]
  @@index([forumPostId])
  @@index([workPostId])
  @@index([parentId])
}

model Upvote {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  forumPostId String?
  forumPost   ForumPost? @relation(fields: [forumPostId], references: [id])

  workPostId  String?
  workPost    WorkPost?  @relation("WorkPostUpvotes", fields: [workPostId], references: [id])

  commentId   String?
  comment     Comment?    @relation(fields: [commentId], references: [id])
  createdAt   DateTime    @default(now())

  @@unique([userId, forumPostId, workPostId, commentId]) // Prevent duplicate votes
}

model Downvote {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  forumPostId String?
  forumPost   ForumPost? @relation(fields: [forumPostId], references: [id])

  workPostId  String?
  workPost    WorkPost?  @relation("WorkPostDownvotes", fields: [workPostId], references: [id])

  commentId   String?
  comment     Comment?    @relation(fields: [commentId], references: [id])
  createdAt   DateTime    @default(now())

  @@unique([userId, forumPostId, workPostId, commentId]) // Prevent duplicate votes
}

model Mention {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  commentId   String
  comment     Comment     @relation(fields: [commentId], references: [id])
  createdAt   DateTime    @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  
  // Recipient
  userId      String
  user   User   @relation("Notification_user", fields: [userId], references: [id])
  
  // Sender (who triggered the notification)
  senderId    String?
  sender User?  @relation("NotificationSender", fields: [senderId], references: [id])
  
  // Notification content
  type        NotificationType
  title       String   // Short summary
  message     String   // Full message
  metadata    Json?    // Flexible additional data
  
  // Related entities (polymorphic relationships)
  forumPostId String?
  forumPost ForumPost? @relation(fields: [forumPostId], references: [id])
  
  workPostId  String?
  workPost    WorkPost? @relation(fields: [workPostId], references: [id])
  
  commentId   String?
  comment     Comment? @relation(fields: [commentId], references: [id])
  
  appointmentId String?
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  
  paymentId   String?
  payment     StripePayment? @relation(fields: [paymentId], references: [id])
  
  // Status and metadata
  isRead      Boolean  @default(false)
  isArchived  Boolean  @default(false)
  priority    Priority @default(MEDIUM)
  expiresAt   DateTime? // For time-sensitive notifications
  
  // System fields
  createdAt   DateTime @default(now())
  readAt      DateTime?
  
  // Indexes
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, priority])
}

enum NotificationType {
  // Social interactions
  POST_LIKE
  POST_DOWNVOTE
  POST_COMMENT
  COMMENT_REPLY
  POST_MENTION
  COMMENT_MENTION
  NEW_FOLLOWER
  COMMENT_UPVOTE
  COMMENT_DOWNVOTE
  
  // Appointments
  APPOINTMENT_BOOKED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER_24HR
  APPOINTMENT_REMINDER_1HR
  APPOINTMENT_NO_SHOW
  APPOINTMENT_COMPLETED
  APPOINTMENT_FAILED
  
  // Payments
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  
  // System
  SYSTEM_ANNOUNCEMENT
  ACCOUNT_VERIFICATION
  PASSWORD_RESET
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Waitlist {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  role               String?
  school             String?
  city               String?
  state              String?
  verified           Boolean  @default(false)
  verificationToken  String?
  verificationSentAt DateTime?
  verifiedAt         DateTime?
  createdAt          DateTime @default(now())
}
